(load "Test.carp")
(use Test)

(deftest test
  (assert-equal test
                "c"
                &(unsafe-format "%c" \c)
                "unsafe-format works on chars")
  (assert-equal test
                "1"
                &(unsafe-format "%d" true)
                "unsafe-format works on bools")
  (assert-equal test
                "10"
                &(unsafe-format "%d" 10)
                "unsafe-format works on ints")
  (assert-equal test
                "10"
                &(unsafe-format "%ld" 10)
                "unsafe-format works on longs")
  (assert-equal test
                "10.0"
                &(unsafe-format "%.1f" 10.0f)
                "unsafe-format works on floats")
  (assert-equal test
                "10.050"
                &(unsafe-format "%2.3f" 10.05)
                "unsafe-format works on doubles")
  (assert-equal test
                "outside string: inside string :outside string"
                &(unsafe-format "outside string: %s :outside string" "inside string")
                "unsafe-format works on strings")
  (assert-equal test
                "100%"
                &(unsafe-format "%d%%" 100)
                "unsafe-format accepts an escaped %% alongside its one directive")
  (assert-equal test
                "10 % 12.0 yay"
                &(fmt "%d %% %.1f %s" 10 12.0 "yay")
                "fmt macro works")
  (assert-equal test
                "hi % 12.0"
                &(fmt "hi %% %.1f" 12.0)
                "fmt macro works with leading % (regression test)")
  (assert-equal test
                "1 [2 3] h"
                &(let [x 1
                       y [2 3]
                       z "hi"]
                  (fstr "{x} {&y} {(head z)}"))
                "fstr works")
  (assert-equal test
                "{}"
                &(fstr "{{}")
                "fstr escaping works"))
